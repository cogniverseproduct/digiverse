# Dependencies
node_modules/
.pnp
.pnp.js

# Production / Build outputs
dist/
build/
out/
.next/

# Environment variables (only *.env.example files are committed)
.env
.env.*
!.env.example
!**/.env.example
*.env

# Vercel CLI link/state (.vercel/project.json can pin the wrong project/directory)
.vercel/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db

# DigiVerse Local Data & Persistence - NEVER commit databases, backups, journals, uploads or dumps.
# (journals and migration reports can contain account identifiers or password hashes)
server/data/*
!server/data/uploads/
server/data/uploads/*
!server/data/uploads/.gitkeep
server/pglite-data/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sql
*.dump
*.journal.json

