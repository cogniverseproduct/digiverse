# DigiVerse client (Vite) environment template. Copy to client/.env.local.
# VITE_* values are embedded in the public JavaScript bundle: never put
# secrets here.

# Official DigiVerse contact addresses shown in the UI. Defaults:
#   primary   contact@cogniverse.co.in
#   secondary mrk@cogniverse.co.in
# These are contact addresses only; they never grant access.
# VITE_DIGIVERSE_PRODUCT_EMAIL=
# VITE_DIGIVERSE_SECONDARY_EMAIL=

# Optional, only after you own a domain:
# Root domain for subdomain sites (<slug>.<root>). Must match SITES_ROOT_DOMAIN on the server.
# VITE_SITES_ROOT_DOMAIN=
# Hostnames that serve the DigiVerse app itself (comma-separated), e.g.
# digiverse-yourname.vercel.app,localhost. Any OTHER hostname reaching the app
# is treated as a client's custom domain. Leave empty to disable custom-domain detection.
# VITE_APP_HOSTNAMES=
