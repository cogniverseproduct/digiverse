{
  "version": 1,
  "pruneIfNoLinks": [".nav-links", "#menu nav", ".ft-col:nth-child(3)"],
  "rules": [
    { "sel": "title", "text": "titleLine" },
    { "sel": "meta[name=\"description\"]", "attr": "content", "value": "description|tagline", "emptyRemove": true },
    { "sel": "meta[property^=\"og:\"]", "all": true, "remove": true },
    { "sel": "meta[name=\"twitter:card\"]", "remove": true },
    { "sel": "meta[name=\"generator\"]", "remove": true },

    { "sel": ".nav-logo", "attr": "aria-label", "value": "{shortName|name}, back to the top" },
    { "sel": ".nav-links a[href=\"#programme\"]", "literal": "Programme" },
    { "sel": ".nav-links a[href=\"#rooms\"]", "literal": "Exhibitors" },
    { "sel": ".nav-links a[href=\"#artists\"]", "literal": "Speakers" },

    { "sel": ".nav-overlay__aside .m-text-5", "literal": "Visit" },
    { "sel": ".nav-overlay__aside .m-text-3", "text": "{dateRange} · {venueLine}", "emptyRemove": ".nav-overlay__aside" },
    { "sel": ".nav-overlay__list a[href=\"#tonight\"]", "literal": "Welcome" },
    { "sel": ".nav-overlay__list a[href=\"#programme\"]", "literal": "Programme" },
    { "sel": ".nav-overlay__list a[href=\"#rooms\"]", "literal": "Exhibitors" },
    { "sel": ".nav-overlay__list a[href=\"#artists\"]", "literal": "Speakers" },
    { "sel": ".nav-overlay__list a[href=\"#pass\"]", "literal": "Tickets" },
    { "sel": ".nav-overlay__list a[href=\"#screening\"]", "remove": true },

    { "sel": ".op-rail__type", "lenVar": "--len", "of": "shortName|name" },
    { "sel": ".op-rail__type", "text": "nameLead|\" \"", "textNode": "first" },
    { "sel": ".op-rail__type .m-text-9__b", "text": "nameLast" },
    { "sel": "#opening-title .m-text-4__ln:nth-child(1)", "text": "name" },
    { "sel": "#opening-title .m-text-4__ln:nth-child(2)", "text": "tagline|cityLine", "emptyRemove": true },
    { "sel": ".op-s2__text > p.m-text", "text": "description", "emptyRemove": true },
    { "sel": ".op-s2__text .m-btn-2", "attr": "href", "value": "bookingUrl|\"#pass\"" },
    { "sel": ".op-s2__text .m-btn-2__label", "literal": "Get tickets" },
    { "sel": ".op-s2__text .m-link .m-link__label", "literal": "See the programme" },
    { "sel": ".op-facts > .op-fact:nth-child(1) dt", "text": "dateRange", "emptyRemove": ".op-fact" },
    { "sel": ".op-facts > .op-fact:nth-child(1) dd", "text": "timeText", "emptyRemove": ".op-fact" },
    { "sel": ".op-facts > .op-fact:nth-child(2) dt", "text": "city", "emptyRemove": ".op-fact" },
    { "sel": ".op-facts > .op-fact:nth-child(2) dd", "text": "venueName", "emptyRemove": ".op-fact" },
    { "sel": ".op-facts > .op-fact:nth-child(3)", "remove": true },

    { "sel": "#programme", "remove": true, "ifEmpty": "days.0.slots.0.time" },
    { "sel": ".pg-head__label .m-text-5", "text": "dateRange", "emptyRemove": true },
    { "sel": "#programme-title .m-text-4__ln:nth-child(1)", "literal": "The" },
    { "sel": "#programme-title .m-text-4__ln:nth-child(2)", "literal": "programme" },
    { "sel": ".pg-head__main > p.m-text", "remove": true },
    { "sel": ".pg-window", "remove": true, "ifEmpty": "gallery.0.url|hero" },
    { "sel": ".pg-window__in > p.m-text-2", "remove": true },
    { "sel": ".pg-arch > img", "repeat": "gallery", "min": 1, "max": 6, "section": ".pg-window", "fields": { ":scope@image": "url" } },
    { "sel": ".pg-list > li.pg-row", "repeat": "days.0.slots", "min": 1, "grow": true, "max": 10, "section": "#programme",
      "fields": {
        "time": "{$.days.0.dateText} · {time}",
        "time@datetime!:keep": "$.startDate",
        "h3": "sessions.0.title",
        ".m-text-2": "{sessions.0.who} · {sessions.0.place}"
      },
      "nested": [ { "sel": ".m-link", "remove": true } ] },

    { "sel": "#rooms", "remove": true, "ifEmpty": "exhibitors.0.name" },
    { "sel": "#rooms-title .m-text-4__ln:nth-child(1)", "literal": "Meet the" },
    { "sel": "#rooms-title .m-text-4__ln:nth-child(2)", "literal": "exhibitors" },
    { "sel": ".rm-intro > p.m-text-3", "remove": true },
    { "sel": ".rm-plan > figure.rm-room", "repeat": "exhibitors", "min": 1, "max": 4, "section": "#rooms",
      "fields": { "img@image": "image|logo", ".m-text-6": "name", ".m-text-3": "{category} · {hall}" } },

    { "sel": "#artists", "remove": true, "ifEmpty": "speakers.0.name" },
    { "sel": ".ar-head__aside .m-text-5", "literal": "Talks and guests" },
    { "sel": "#artists-title .m-text-4__ln:nth-child(1)", "literal": "Meet the" },
    { "sel": "#artists-title .m-text-4__ln:nth-child(2)", "literal": "speakers" },
    { "sel": ".ar-head__main > p.m-text", "remove": true },
    { "sel": ".ar-list > li.ar-row", "repeat": "speakers", "min": 1, "grow": true, "max": 8, "section": "#artists",
      "fields": { ".ar-first": "first", ".ar-last": "rest", ".ar-role": "{role}", "img@image!figure": "photo" },
      "nested": [ { "sel": ".ar-name", "lenVar": "--len", "of": "name" } ] },

    { "sel": "#screening", "remove": true },
    { "sel": "#relay", "remove": true },
    { "sel": "#journal", "remove": true },

    { "sel": "#pass", "remove": true, "ifEmpty": "tickets.0.name" },
    { "sel": "#pass-title .m-text-4__ln:nth-child(1)", "literal": "Tickets" },
    { "sel": "#pass-title .m-text-4__ln:nth-child(2)", "literal": "and passes" },
    { "sel": ".ps-head__main > p.m-text", "remove": true },
    { "sel": ".ps-row > article.ps-card", "repeat": "tickets", "min": 1, "max": 3, "section": "#pass",
      "fields": { "h3": "name", ".ps-price .m-text-6": "price", ".ps-price .m-text": "description" },
      "nested": [
        { "sel": ".ps-list > li", "repeat": "features", "min": 1, "grow": true, "section": ".ps-list", "fields": { "span": "value" } },
        { "sel": ".m-btn__label", "literal": "Get tickets" },
        { "sel": "a.m-btn", "attr": "href", "value": "url", "emptyRemove": true }
      ] },

    { "sel": "#faq", "remove": true, "ifEmpty": "faqs.0.question" },
    { "sel": "#faq-title .m-text-4__ln:nth-child(2)", "literal": "answered" },
    { "sel": ".fq-intro > p.m-text-2", "remove": true },
    { "sel": ".fq-list > details.fq-item", "repeat": "faqs", "min": 1, "grow": true, "max": 8, "section": "#faq",
      "fields": { "summary .m-text-8": "question", "p.m-text": "answer" } },

    { "sel": ".ct-info > div:nth-child(1) dd", "text": "venueFull|cityLine", "emptyRemove": "div" },
    { "sel": ".ct-info > div:nth-child(2) dt", "literal": "When" },
    { "sel": ".ct-info > div:nth-child(2) dd", "text": "{dateRange} · {timeText}", "emptyRemove": "div" },
    { "sel": ".ct-info > div:nth-child(3) a", "attr": "href", "value": "mailto", "emptyRemove": "div" },
    { "sel": ".ct-info > div:nth-child(3) a", "text": "email", "emptyRemove": "div" },
    { "sel": ".ct-info > div:nth-child(4) a", "attr": "href", "value": "tel", "emptyRemove": "div" },
    { "sel": ".ct-info > div:nth-child(4) a", "text": "phone", "emptyRemove": "div" },
    { "sel": "#contact-title .m-text-4__ln:nth-child(1)", "literal": "Get in" },
    { "sel": "#contact-title .m-text-4__ln:nth-child(2)", "literal": "touch" },

    { "sel": ".ft-mark", "lenVar": "--len", "of": "shortName|name" },
    { "sel": ".ft-mark", "text": "nameLead|\" \"", "textNode": "first" },
    { "sel": ".ft-mark .m-text-4__b", "text": "nameLast" },
    { "sel": ".ft-col:nth-child(1) .m-text-5", "text": "shortName|name" },
    { "sel": ".ft-col:nth-child(1) .m-text-3", "text": "venueFull|cityLine|tagline", "emptyRemove": true },
    { "sel": ".ft-col:nth-child(2) .m-text-5", "literal": "When" },
    { "sel": ".ft-col:nth-child(2) .m-text-3", "text": "{dateRange} · {timeText}", "emptyRemove": ".ft-col" },
    { "sel": ".ft-col:nth-child(3) a[href=\"#programme\"]", "literal": "Programme" },
    { "sel": ".ft-col:nth-child(3) a[href=\"#rooms\"]", "literal": "Exhibitors" },
    { "sel": ".ft-col:nth-child(3) a[href=\"#pass\"]", "literal": "Tickets" },
    { "sel": ".ft-col:nth-child(4) li", "repeat": "social", "min": 1, "grow": true, "section": ".ft-col:nth-child(4)", "proto": ".ft-col:nth-child(4) li:nth-child(1)",
      "fields": { "a@href": "url", "a": "label" } },
    { "sel": ".ft-base", "text": "© {year} {shortName|name} · Design:", "textNode": "first", "trailingSpace": true }
  ]
}
