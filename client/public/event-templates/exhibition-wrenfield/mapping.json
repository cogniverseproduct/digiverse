{
  "version": 1,
  "pruneIfNoLinks": [".nav__links", ".nav__overlay ul", ".ft-cols > div:nth-child(2)", ".ft-cols > div:nth-child(3)", ".ft-cols > div:nth-child(4)"],
  "rules": [
    { "sel": "title", "text": "titleLine" },
    { "sel": "meta[name=\"description\"]", "attr": "content", "value": "description|tagline", "emptyRemove": true },
    { "sel": "meta[property^=\"og:\"]", "all": true, "remove": true },
    { "sel": "meta[name=\"twitter:card\"]", "remove": true },
    { "sel": "meta[name=\"generator\"]", "remove": true },

    { "sel": ".nav__mark", "text": "shortName|name", "textNode": "first" },
    { "sel": ".nav__mark", "attr": "aria-label", "value": "{shortName|name}, back to the top" },
    { "sel": ".nav__social", "remove": true },
    { "sel": ".nav__links a[href=\"#halls\"]", "literal": "Exhibitors" },
    { "sel": ".nav__links a[href=\"#exhibition\"]", "literal": "About" },
    { "sel": ".nav__links a[href=\"#drawers\"]", "attr": "href", "value": "\"#lates\"" },
    { "sel": ".nav__links a[href=\"#drawers\"]", "literal": "Programme" },
    { "sel": ".nav__links a[href=\"#learn\"]", "attr": "href", "value": "\"#support\"" },
    { "sel": ".nav__links a[href=\"#learn\"]", "literal": "Tickets" },
    { "sel": ".nav__own a[href=\"#support\"]", "attr": "aria-label", "value": "\"Tickets\"" },
    { "sel": ".nav__own a[href=\"#visit\"]", "attr": "aria-label", "value": "\"Visit\"" },
    { "sel": ".nav__overlay a[href=\"#halls\"]", "literal": "Exhibitors" },
    { "sel": ".nav__overlay a[href=\"#exhibition\"]", "literal": "About" },
    { "sel": ".nav__overlay a[href=\"#drawers\"]", "attr": "href", "value": "\"#lates\"" },
    { "sel": ".nav__overlay a[href=\"#drawers\"]", "literal": "Programme" },
    { "sel": ".nav__overlay a[href=\"#learn\"]", "attr": "href", "value": "\"#support\"" },
    { "sel": ".nav__overlay a[href=\"#learn\"]", "literal": "Tickets" },
    { "sel": ".nav__overlay-note", "text": "{dateRange} · {timeText} · {cityLine}", "emptyRemove": true },

    { "sel": ".op-plate-in img", "all": true, "image": "hero|gallery.0.url" },
    { "sel": ".op-second__panel h1", "text": "name", "textNode": "first" },
    { "sel": ".op-second__panel > p.m-text", "text": "tagline|description", "emptyRemove": true },
    { "sel": ".op-cta a.m-btn", "attr": "href", "value": "bookingUrl|\"#visit\"" },
    { "sel": ".op-label > .m-surface__row:nth-child(1) dt", "literal": "Dates" },
    { "sel": ".op-label > .m-surface__row:nth-child(1) dd", "text": "dateRange", "emptyRemove": ".m-surface__row" },
    { "sel": ".op-label > .m-surface__row:nth-child(2) dt", "literal": "Where" },
    { "sel": ".op-label > .m-surface__row:nth-child(2) dd", "text": "venueLine|cityLine", "emptyRemove": ".m-surface__row" },
    { "sel": ".op-label > .m-surface__row:nth-child(3) dt", "literal": "Open" },
    { "sel": ".op-label > .m-surface__row:nth-child(3) dd", "text": "timeText", "emptyRemove": ".m-surface__row" },
    { "sel": ".op-second__panel a.m-link .m-link__label", "literal": "See the exhibitors" },

    { "sel": "#halls", "remove": true, "ifEmpty": "exhibitors.0.name" },
    { "sel": ".hl-intro h2", "literal": "Meet the exhibitors" },
    { "sel": ".hl-intro p", "all": true, "remove": true },
    { "sel": ".hl-track > article.hl-hall", "repeat": "exhibitors", "min": 1, "grow": true, "max": 8, "section": "#halls",
      "fields": { ".hl-name@text": "name", ".hl-plate img@image": "image|logo", ".hl-meta": "{category} · {hall}", "p.m-text": "description" } },

    { "sel": ".ex-w--1", "text": "nameLead|\" \"" },
    { "sel": ".ex-w--2", "text": "nameLast" },
    { "sel": ".ex-sheet", "remove": true, "ifEmpty": "hero|gallery.0.url" },
    { "sel": ".ex-print img", "all": true, "image": "hero|gallery.0.url" },
    { "sel": ".ex-sheet figcaption", "text": "tagline", "emptyRemove": true },
    { "sel": ".ex-info > p.m-text-5", "text": "tagline", "emptyRemove": true },
    { "sel": ".ex-info > p.m-text", "text": "description", "emptyRemove": true },
    { "sel": ".ex-info dl > .m-surface__row:nth-child(1) dd", "text": "dateRange", "emptyRemove": ".m-surface__row" },
    { "sel": ".ex-info dl > .m-surface__row:nth-child(2) dd", "text": "venueLine|cityLine", "emptyRemove": ".m-surface__row" },
    { "sel": ".ex-info dl > .m-surface__row:nth-child(3) dt", "literal": "Tickets" },
    { "sel": ".ex-info dl > .m-surface__row:nth-child(3) dd", "text": "{tickets.0.name} · {tickets.0.price}", "emptyRemove": ".m-surface__row" },
    { "sel": ".ex-info a.m-btn-2", "attr": "href", "value": "bookingUrl|\"#support\"" },
    { "sel": ".ex-info a.m-btn-2 .m-btn-2__label", "literal": "Get tickets" },

    { "sel": "#drawers", "remove": true },
    { "sel": "#field", "remove": true },
    { "sel": "#learn", "remove": true },

    { "sel": "#lates", "remove": true, "ifEmpty": "days.0.slots.0.time" },
    { "sel": ".lt-photo", "remove": true, "ifEmpty": "gallery.0.url|hero" },
    { "sel": ".lt-photo img", "image": "gallery.0.url|hero" },
    { "sel": ".lt-word", "literal": "Programme" },
    { "sel": ".lt-intro h2", "literal": "What is on" },
    { "sel": ".lt-intro p", "remove": true },
    { "sel": ".lt-list > li", "repeat": "days.0.slots", "min": 1, "grow": true, "max": 8, "section": "#lates",
      "fields": { ".m-text-2": "{$.days.0.dateText} · {time}", "h3": "sessions.0.title", "p.m-text": "{sessions.0.who} · {sessions.0.place}" },
      "nested": [ { "sel": ".m-link", "remove": true } ] },

    { "sel": "#support", "remove": true, "ifEmpty": "tickets.0.name" },
    { "sel": ".sp-text h2", "literal": "Tickets" },
    { "sel": ".sp-text p", "all": true, "remove": true },
    { "sel": ".sp-cat", "remove": true, "ifEmpty": "gallery.0.url|hero" },
    { "sel": ".sp-cat img", "all": true, "image": "gallery.0.url|hero" },
    { "sel": ".sp-labels > article.sp-label", "repeat": "tickets", "min": 1, "grow": true, "max": 6, "section": "#support",
      "fields": { "h3": "name", "dl > .m-surface__row:nth-child(1) dd": "price", "dl > .m-surface__row:nth-child(2) dd!.m-surface__row": "description|features.0" },
      "nested": [
        { "sel": "dl > .m-surface__row:nth-child(1) dt", "literal": "Price" },
        { "sel": ".m-btn__label", "literal": "Get tickets" },
        { "sel": "a.m-btn", "attr": "href", "value": "url", "emptyRemove": true }
      ] },

    { "sel": "#visit", "remove": true, "ifEmpty": "venueFull|dateRange|timeText" },
    { "sel": ".vs-photo", "remove": true, "ifEmpty": "gallery.0.url|hero" },
    { "sel": ".vs-photo img", "image": "gallery.0.url|hero" },
    { "sel": ".vs-body h2", "literal": "Visit us" },
    { "sel": ".vs-col:nth-child(1) p", "text": "{dateRange} · {timeText}", "emptyRemove": ".vs-col" },
    { "sel": ".vs-col:nth-child(2) h3", "literal": "Tickets" },
    { "sel": ".vs-col:nth-child(2) p", "text": "{tickets.0.name} · {tickets.0.price}", "emptyRemove": ".vs-col" },
    { "sel": ".vs-col:nth-child(3) p", "text": "{venueFull}. {transit}", "emptyRemove": ".vs-col" },
    { "sel": ".vs-col:nth-child(4) p", "text": "access|parking", "emptyRemove": ".vs-col" },
    { "sel": ".vs-act a.m-btn-2", "attr": "href", "value": "bookingUrl|\"#support\"" },
    { "sel": ".vs-act a.m-btn-2 .m-btn-2__label", "literal": "Get tickets" },
    { "sel": ".vs-act a.m-btn", "remove": true },

    { "sel": "#faq", "remove": true, "ifEmpty": "faqs.0.question" },
    { "sel": ".fq-head p", "remove": true },
    { "sel": ".fq-list > details", "repeat": "faqs", "min": 1, "grow": true, "max": 8, "section": "#faq",
      "fields": { "summary > span:first-child": "question", "p.m-text": "answer" } },

    { "sel": ".ct-head h2", "literal": "Get in touch" },
    { "sel": ".ct-head p", "remove": true },
    { "sel": ".ct-grid > .ct-col:nth-child(1)", "remove": true },
    { "sel": ".ct-grid > .ct-col:nth-child(4)", "remove": true },
    { "sel": ".ct-grid > .ct-col:nth-child(2) .ct-big", "attr": "href", "value": "tel", "emptyRemove": ".ct-col" },
    { "sel": ".ct-grid > .ct-col:nth-child(2) .ct-big", "text": "phone", "emptyRemove": ".ct-col" },
    { "sel": ".ct-grid > .ct-col:nth-child(2) p", "remove": true },
    { "sel": ".ct-grid > .ct-col:nth-child(3) address", "text": "venueFull|cityLine", "emptyRemove": true },
    { "sel": ".ct-grid > .ct-col:nth-child(3) a.m-link", "attr": "href", "value": "mailto", "emptyRemove": true },
    { "sel": ".ct-grid > .ct-col:nth-child(3) a.m-link .m-link__label", "text": "email", "emptyRemove": ".m-link" },

    { "sel": ".ft-word", "lenVar": "--len", "of": "shortName|name" },
    { "sel": ".ft-word", "text": "shortName|name", "textNode": "first" },
    { "sel": ".ft-cols > div:nth-child(1) li:nth-child(1)", "text": "venueFull|cityLine", "emptyRemove": true },
    { "sel": ".ft-cols > div:nth-child(1) li:nth-child(2)", "text": "{dateRange} · {timeText}", "emptyRemove": true },
    { "sel": ".ft-cols > div:nth-child(1) li:nth-child(3)", "remove": true },
    { "sel": ".ft-cols > div:nth-child(2) h3", "literal": "Explore" },
    { "sel": ".ft-cols > div:nth-child(2) a[href=\"#halls\"]", "literal": "Exhibitors" },
    { "sel": ".ft-cols > div:nth-child(2) a[href=\"#exhibition\"]", "literal": "About" },
    { "sel": ".ft-cols > div:nth-child(2) a[href=\"#drawers\"]", "attr": "href", "value": "\"#lates\"" },
    { "sel": ".ft-cols > div:nth-child(2) a[href=\"#drawers\"]", "literal": "Programme" },
    { "sel": ".ft-cols > div:nth-child(2) a[href=\"#learn\"]", "remove": true },
    { "sel": ".ft-cols > div:nth-child(3) h3", "literal": "Tickets" },
    { "sel": ".ft-cols > div:nth-child(3) li:nth-child(1) a", "literal": "Get tickets" },
    { "sel": ".ft-cols > div:nth-child(3) li:nth-child(2)", "remove": true },
    { "sel": ".ft-cols > div:nth-child(3) li:nth-child(3)", "remove": true },
    { "sel": ".ft-cols > div:nth-child(4) li:nth-child(1) a", "attr": "href", "value": "tel", "emptyRemove": "li" },
    { "sel": ".ft-cols > div:nth-child(4) li:nth-child(1) a", "text": "phone", "emptyRemove": "li" },
    { "sel": ".ft-cols > div:nth-child(4) li:nth-child(2) a", "attr": "href", "value": "mailto", "emptyRemove": "li" },
    { "sel": ".ft-cols > div:nth-child(4) li:nth-child(2) a", "text": "email", "emptyRemove": "li" },
    { "sel": ".ft-cols > div:nth-child(4) li:nth-child(3)", "repeat": "social", "min": 1, "grow": true, "proto": ".ft-cols > div:nth-child(4) li:nth-child(3)",
      "fields": { "a@href": "url", "a": "label" } },
    { "sel": ".ft-base > p:first-child", "text": "© {year} {shortName|name} · Design:", "textNode": "first", "trailingSpace": true }
  ]
}
