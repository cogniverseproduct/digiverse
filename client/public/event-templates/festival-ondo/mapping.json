{
  "version": 1,
  "brandVars": { "--color-2": "primary", "--color-5": "accent" },
  "pruneIfNoLinks": ["#navigation > nav", ".ft-links", ".op-actions"],
  "rules": [
    { "sel": "title", "text": "titleLine" },
    { "sel": "meta[name=\"description\"]", "attr": "content", "value": "description|tagline", "emptyRemove": true },
    { "sel": "meta[property^=\"og:\"]", "all": true, "remove": true },
    { "sel": "meta[name=\"twitter:card\"]", "remove": true },
    { "sel": "link[rel=\"preconnect\"][href*=\"unsplash\"]", "remove": true },

    { "sel": ".nav__logo > span:first-child", "text": "shortName|name" },
    { "sel": ".nav__logo [lang=\"ko\"]", "remove": true },
    { "sel": ".nav__logo", "attr": "aria-label", "value": "{shortName|name}, back to the top" },
    { "sel": ".nav__cta", "attr": "href", "value": "bookingUrl|\"#tickets\"" },
    { "sel": ".menu__meta", "text": "{dateRange} · {venueLine}", "emptyRemove": true },

    { "sel": "#battle", "remove": true },
    { "sel": "#zones", "remove": true },
    { "sel": "#looks", "remove": true },
    { "sel": "#food", "remove": true },
    { "sel": "#partners", "remove": true },

    { "sel": ".op-meta > div:nth-child(1) dd", "text": "dateRange", "emptyRemove": "div" },
    { "sel": ".op-meta > div:nth-child(2) dd", "text": "venueLine", "emptyRemove": "div" },
    { "sel": ".op-upper > p.m-text-5", "text": "description", "emptyRemove": true },
    { "sel": "picture source", "all": true, "remove": true },
    { "sel": ".op-photo", "image": "hero|gallery.0.url", "emptyRemove": "picture" },
    { "sel": "#opening-title", "lenVar": "--len", "of": "name" },
    { "sel": "#opening-title .op-word--a", "text": "nameFirst", "emptyRemove": true },
    { "sel": "#opening-title .op-word--b", "text": "nameMid", "emptyRemove": true },
    { "sel": "#opening-title .op-word--c", "text": "nameLast" },
    { "sel": ".op-tag", "text": "tagline", "emptyRemove": true },
    { "sel": ".op-actions a.m-btn", "attr": "href", "value": "bookingUrl|\"#tickets\"" },

    { "sel": ".op-two", "remove": true, "ifEmpty": "days.0.slots.0.time" },
    { "sel": "#day", "literal": "The schedule" },
    { "sel": ".op-two__note > p", "remove": true },
    { "sel": ".op-veil__hole", "repeat": "days.0.slots", "max": 9, "min": 1, "fields": {} },
    { "sel": ".op-rings > li", "repeat": "days.0.slots", "max": 9, "min": 1, "section": ".op-two",
      "fields": { ".m-ring__time": "time", ".m-ring__label": "sessions.0.title" } },
    { "sel": ".op-two__foot p:nth-child(1)", "text": "Times in {timezone}", "emptyRemove": true },
    { "sel": ".op-two__foot p:nth-child(2)", "text": "venueAddress|venueLine", "emptyRemove": true },

    { "sel": "#lineup", "remove": true, "ifEmpty": "speakers.0.name" },
    { "sel": ".lu-lead", "remove": true },
    { "sel": ".lu-more", "remove": true },
    { "sel": ".lu-list > li.lu-row", "repeat": "speakers", "min": 1, "grow": true, "max": 12, "section": "#lineup",
      "fields": { ".lu-name": "name" },
      "nested": [
        { "sel": ".lu-name", "lenVar": "--len", "of": "name" },
        { "sel": ".lu-face", "remove": true, "ifEmpty": "photo" },
        { "sel": ".lu-face img", "image": "photo" },
        { "sel": ".lu-when > span:first-child", "text": "role", "emptyRemove": true },
        { "sel": ".lu-when > span:last-child", "text": "topic", "emptyRemove": true }
      ] },

    { "sel": "#fanwall", "remove": true, "ifEmpty": "gallery.0.url" },
    { "sel": "#fanwall-title", "literal": "Gallery" },
    { "sel": ".fw-head p", "remove": true },
    { "sel": ".fw-tag", "remove": true },
    { "sel": ".fw-wall > li", "repeat": "gallery", "min": 1, "max": 8, "section": "#fanwall",
      "fields": { "img@image": "url", "img@alt": "{caption}" } },

    { "sel": "#tickets", "remove": true, "ifEmpty": "tickets.0.name" },
    { "sel": ".tk-head p", "remove": true },
    { "sel": ".tk-note", "remove": true },
    { "sel": ".tk-passes > li", "repeat": "tickets", "min": 1, "grow": true, "max": 6, "section": "#tickets",
      "fields": { ".tk-name": "name" },
      "nested": [
        { "sel": ".m-badge", "text": "badge", "emptyRemove": true },
        { "sel": ".tk-price", "text": "price", "emptyRemove": true },
        { "sel": ".tk-list > li", "repeat": "features", "min": 1, "grow": true, "section": ".tk-list", "fields": { ":scope": "value" } },
        { "sel": ".m-btn__label", "literal": "Get this pass" },
        { "sel": ".m-btn", "attr": "href", "value": "url", "emptyRemove": true }
      ] },

    { "sel": "#faq", "remove": true, "ifEmpty": "faqs.0.question" },
    { "sel": ".fq-head > p", "literal": "Still unsure about something?" },
    { "sel": ".fq-head a.m-link", "attr": "href", "value": "mailto", "emptyRemove": true },
    { "sel": ".fq-head a.m-link", "text": "email" },
    { "sel": ".fq-list > details", "repeat": "faqs", "min": 1, "grow": true, "section": "#faq", "fields": { "summary": "question", "p": "answer" } },

    { "sel": "#contact-title", "literal": "See you there" },
    { "sel": ".ct-mail", "attr": "href", "value": "mailto", "emptyRemove": true },
    { "sel": ".ct-mail", "text": "email" },
    { "sel": ".ct-list > div:nth-child(1)", "remove": true, "ifEmpty": "venueName|venueAddress|cityLine" },
    { "sel": ".ct-list > div:nth-child(1) dd", "text": "{venueName}, {venueAddress}, {cityLine}" },
    { "sel": ".ct-list > div:nth-child(2)", "remove": true, "ifEmpty": "airport|transit|parking" },
    { "sel": ".ct-list > div:nth-child(2) dd", "text": "{airport} {transit} {parking}" },
    { "sel": ".ct-list > div:nth-child(3)", "remove": true, "ifEmpty": "tel" },
    { "sel": ".ct-list > div:nth-child(3) dt", "literal": "Phone" },
    { "sel": ".ct-list > div:nth-child(3) dd", "text": "\" \"", "textNode": true },
    { "sel": ".ct-list > div:nth-child(3) a", "attr": "href", "value": "tel", "emptyRemove": true },
    { "sel": ".ct-list > div:nth-child(3) a", "text": "phone" },
    { "sel": ".ct-list > div:nth-child(4)", "remove": true },

    { "sel": ".ft-mark", "text": "shortName|name" },
    { "sel": ".ft-mark", "lenVar": "--len", "of": "shortName|name" },
    { "sel": ".ft-links > li:nth-child(5)", "remove": true },
    { "sel": ".ft-links > li:nth-child(4)", "repeat": "social", "min": 1, "grow": true, "proto": ".ft-links > li:nth-child(4)",
      "fields": { "a@href": "url", "a": "label" } },
    { "sel": ".ft-row small", "text": "© {year} {shortName|name} · Design:", "textNode": "first", "trailingSpace": true }
  ]
}
