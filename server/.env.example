# DigiVerse server environment template.
# Copy to server/.env for local development. NEVER commit real values.
# On Vercel, set the same names in Project -> Settings -> Environment Variables.

# --- Required everywhere -------------------------------------------------
# Random string of at least 32 characters (e.g. `openssl rand -hex 32`).
# Generate a NEW one for production; never reuse the local development value.
JWT_SECRET=

# --- Local development ---------------------------------------------------
PORT=3001
# Leave DATABASE_URL empty locally to use server/data/digiverse.db (SQLite).
# DATABASE_DRIVER=sqlite          # sqlite | postgres | pglite (in-memory Postgres for testing). Any other value is an error.
#                                 # Do NOT set it in production: DATABASE_URL alone selects Postgres.
# SQLITE_PATH=                    # optional override for the SQLite file
# PG_POOL_MAX=                    # Postgres pool size per instance (default 3 on Vercel, 10 elsewhere)

# --- Database (required on Vercel) ---------------------------------------
# Postgres connection string. With Neon, use the *pooled* connection string.
# Setting this switches the server to Postgres automatically.
DATABASE_URL=

# --- First Super Admin on Vercel (one time) ------------------------------
# At least 24 random characters. Required only to create the first Super
# Admin from a non-local request; remove it after setup is complete.
SETUP_KEY=

# --- Media storage --------------------------------------------------------
# Added automatically when a Vercel Blob store is connected to the project.
# When set, uploads go to Vercel Blob instead of server/data/uploads.
BLOB_READ_WRITE_TOKEN=
# Optional upload limit in MB (default 3 on Vercel because of the 4.5 MB
# request-body limit; 10/15 locally).
# MAX_UPLOAD_MB=

# --- Public URLs and routing ---------------------------------------------
# Public URL of the main app, e.g. https://digiverse-yourname.vercel.app
# Optional on Vercel (the production URL is detected automatically).
PUBLIC_APP_URL=
# Optional: serve sites at https://<slug>.<SITES_ROOT_DOMAIN>. Requires a
# domain you own with a wildcard record. Leave empty until you have one.
SITES_ROOT_DOMAIN=
# Extra allowed CORS origins (comma-separated). Same-origin needs nothing.
CORS_ORIGINS=

# --- Vercel publishing (centralized: ONE DigiVerse Vercel team hosts every client site)
# Clients never need Vercel accounts. Without credentials DigiVerse starts normally,
# every engine works, and the Publishing Console shows "Vercel setup pending".
# Full activation steps: docs/deployment/VERCEL.md
#
# Turn real Vercel publishing on (only after the token below is set).
VERCEL_ENABLED=false
# Token of the DigiVerse Vercel account/team (Account Settings > Tokens). Server-side only.
VERCEL_TOKEN=
# The DigiVerse team id (team_...), required when the token belongs to a team.
VERCEL_TEAM_ID=
# Optional: secret for the signed deployment webhook (POST /api/vercel/webhook).
# Status is also refreshed when the console reads it, so this is optional.
VERCEL_WEBHOOK_SECRET=
# If your Vercel dashboard refuses names starting with VERCEL_, use these identical aliases:
#   DIGIVERSE_VERCEL_ENABLED, DIGIVERSE_VERCEL_TOKEN, DIGIVERSE_VERCEL_TEAM_ID, DIGIVERSE_VERCEL_WEBHOOK_SECRET
#
# LOCAL ONLY: simulate publishing so you can test the whole workflow without Vercel.
# Simulated deployments are always labelled "Simulated" and are never real Vercel deployments.
# Ignored on Vercel and when NODE_ENV=production. Set to true only on your own machine.
PUBLISH_MOCK_MODE=false
# Delay between simulated states in milliseconds (default 1500).
# PUBLISH_MOCK_STEP_MS=1500
# Set to "fail" to rehearse a failed deployment.
# PUBLISH_MOCK_OUTCOME=ready
# Only if the standalone site bundle lives somewhere else (default: server/dist/site-bundle).
# SITE_BUNDLE_DIR=

# --- Custom domains for client sites (optional, later) -------------------
# Custom domains are attached to each client's OWN Vercel project using the
# VERCEL_TOKEN above. These legacy settings still work for sites that are served
# by the shared DigiVerse deployment.
DIGIVERSE_VERCEL_API_TOKEN=
# Defaults to Vercel's own VERCEL_PROJECT_ID inside a deployment.
DIGIVERSE_VERCEL_PROJECT_ID=
# Only if the project belongs to a Vercel team.
DIGIVERSE_VERCEL_TEAM_ID=

# --- Optional integrations -----------------------------------------------
# Server-side only. Never expose them in client code or published sites.
GOOGLE_DRIVE_API_KEY=
GOOGLE_ACCESS_TOKEN=

# --- Email identity and notifications -------------------------------------
# Official DigiVerse addresses. Defaults are used when these are empty:
#   primary   contact@cogniverse.co.in  (first-run Super Admin identity for NEW
#             installs, owner notifications, default sender and reply-to)
#   secondary mrk@cogniverse.co.in      (copied on owner notifications)
# They are contact addresses only: setting one never creates an account or grants
# a role. Existing accounts are migrated with `npm run db:migrate-email`
# (see docs/deployment/EMAIL_IDENTITY_MIGRATION.md).
PLATFORM_PRIMARY_EMAIL=
PLATFORM_SECONDARY_EMAIL=

# SMTP (leave empty to only log messages; nothing is then sent). DigiVerse does
# NOT assume the mailboxes above are already set up: get the host and credentials
# from your mail provider. Never commit real values.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); defaults to true only when SMTP_PORT=465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# From and Reply-To. Default to PLATFORM_PRIMARY_EMAIL. Many providers only allow a
# sender address they have verified for your account.
MAIL_FROM=
MAIL_REPLY_TO=
