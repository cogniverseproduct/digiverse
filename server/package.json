{
  "name": "digiverse-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 test/unit/*.test.ts",
    "db:migrate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate-email": "tsx scripts/migrate-email-identity.ts",
    "auth:recover-super-admin": "tsx scripts/super-admin-recovery.ts",
    "db:rehearse-migration": "tsx scripts/verify-migration.local.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "linkedom": "^0.18.15",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
